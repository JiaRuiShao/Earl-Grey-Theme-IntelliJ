  "ui": {
    "*": {
      "background": "eg.background",
      "foreground": "eg.foreground",
      "selectionBackground": "eg.purple2",
      "selectionForeground": "eg.foreground",
      "selectionInactiveBackground": "eg.grey1",
      "selectionInactiveForeground": "eg.foreground",
      "borderColor": "eg.grey2",
      "disabledBorderColor": "eg.grey1",
      "disabledForeground": "eg.grey4",
      "acceleratorForeground": "eg.foregroundAlt",
      "infoForeground": "eg.comment"
    },

    "ToolWindow": {
      "background": "eg.backgroundAlt",
      "Header.background": "eg.backgroundAlt",
      "Header.inactiveBackground": "eg.backgroundAlt",
      "Header.borderColor": "eg.grey2",
      "Header.closeButtonBackground": "eg.backgroundAlt",
      "HeaderTab.background": "eg.backgroundAlt",
      "HeaderTab.inactiveBackground": "eg.backgroundAlt",
      "HeaderTab.hoverBackground": "eg.grey1",
      "HeaderTab.hoverInactiveBackground": "eg.grey1",
      "HeaderTab.underlinedTabBackground": "eg.background",
      "HeaderTab.underlinedTabInactiveBackground": "eg.background",
      "HeaderTab.selectedInactiveBackground": "eg.background",
      "HeaderTab.underlineColor": "eg.purple",
      "HeaderTab.underlineHeight": 2,
      "HeaderCloseButton.background": "eg.backgroundAlt"
    },

    "ToolWindow.Button": {
      "selectedBackground": "eg.purple2",
      "hoverBackground": "eg.grey1"
    },

    "Tree": {
      "background": "eg.backgroundAlt",
      "foreground": "eg.foreground",
      "selectionBackground": "eg.purple2",
      "selectionForeground": "eg.foreground",
      "selectionInactiveBackground": "eg.grey1",
      "selectionInactiveForeground": "eg.foreground",
      "hash.background": "eg.backgroundAlt",
      "row.height": 22
    },

    "List": {
      "background": "eg.backgroundAlt",
      "foreground": "eg.foreground",
      "selectionBackground": "eg.purple2",
      "selectionInactiveBackground": "eg.grey1"
    },

    "Table": {
      "background": "eg.backgroundAlt",
      "foreground": "eg.foreground",
      "selectionBackground": "eg.purple2",
      "gridColor": "eg.grey2",
      "lightSelectionBackground": "eg.grey1"
    },

    "Panel": {
      "background": "eg.backgroundAlt",
      "foreground": "eg.foreground"
    },

    "ProjectViewTree": {
      "background": "eg.backgroundAlt"
    },

    "SpeedSearch": {
      "background": "eg.berry2",
      "foreground": "eg.foreground",
      "borderColor": "eg.berry"
    },

    "EditorTabs": {
      "background": "eg.grey1",
      "underlinedTabBackground": "eg.background",
      "inactiveUnderlineColor": "eg.grey3",
      "underlineColor": "eg.purple",
      "underlineHeight": 2,
      "hoverBackground": "eg.grey2",
      "hoverInactiveBackground": "eg.grey2"
    },

    "MainToolbar": {
      "background": "eg.backgroundAlt"
    },

    "MainWindow": {
      "background": "eg.backgroundAlt"
    },

    "StatusBar": {
      "background": "eg.backgroundAlt",
      "borderColor": "eg.grey2",
      "foreground": "eg.comment"
    },

    "ToolBar": {
      "background": "eg.backgroundAlt"
    },

    "ActionButton": {
      "hoverBackground": "eg.grey1",
      "pressedBackground": "eg.grey2"
    },

    "Menu": {
      "background": "eg.background",
      "foreground": "eg.foreground",
      "selectionBackground": "eg.purple2",
      "borderColor": "eg.grey2"
    },

    "MenuItem": {
      "background": "eg.background",
      "foreground": "eg.foreground",
      "selectionBackground": "eg.purple2",
      "acceleratorForeground": "eg.comment"
    },

    "PopupMenu": {
      "background": "eg.background",
      "border": "eg.grey2"
    },

    "Popup": {
      "background": "eg.background",
      "borderColor": "eg.grey2",
      "Header.activeBackground": "eg.backgroundAlt",
      "Header.inactiveBackground": "eg.backgroundAlt"
    },

    "ScrollBar": {
      "thumbColor": "eg.grey3",
      "thumbBorderColor": "eg.grey3",
      "trackColor": "eg.backgroundAlt",
      "hoverThumbColor": "eg.grey4"
    },

    "Button": {
      "background": "eg.grey1",
      "startBackground": "eg.grey1",
      "endBackground": "eg.grey1",
      "foreground": "eg.foreground",
      "borderColor": "eg.grey3",
      "default": {
        "startBackground": "eg.purple2",
        "endBackground": "eg.purple2",
        "foreground": "eg.foreground",
        "focusedBorderColor": "eg.purple"
      }
    },

    "TextField": {
      "background": "eg.background",
      "foreground": "eg.foreground",
      "borderColor": "eg.grey3"
    },

    "TextArea": {
      "background": "eg.background",
      "foreground": "eg.foreground"
    },

    "ComboBox": {
      "background": "eg.background",
      "foreground": "eg.foreground",
      "ArrowButton.background": "eg.background"
    },

    "CheckBox": {
      "background": "eg.backgroundAlt"
    },

    "TabbedPane": {
      "background": "eg.backgroundAlt",
      "underlineColor": "eg.purple",
      "hoverColor": "eg.grey1"
    },

    "Notification": {
      "background": "eg.backgroundAlt",
      "foreground": "eg.foreground",
      "borderColor": "eg.grey2",
      "ToolWindow.informativeBackground": "eg.purple1",
      "ToolWindow.errorBackground": "#F1EBE8",
      "ToolWindow.warningBackground": "#F0EDE7"
    },

    "SearchEverywhere": {
      "background": "eg.background",
      "SearchField.background": "eg.background",
      "List.background": "eg.background"
    },

    "VersionControl.Log.Commit": {
      "Reference.foreground": "eg.blue"
    },

    "Component.borderColor": "eg.grey2",
    "Component.focusedBorderColor": "eg.purple",

    "Link": {
      "activeForeground": "eg.blue",
      "hoverForeground": "eg.purple",
      "visitedForeground": "eg.blue",
      "pressedForeground": "eg.purple"
    }
