<scheme name="Earl Grey" version="142" parent_scheme="Default">
  <!--
    Earl Grey for IntelliJ IDEA / JetBrains IDEs.

    A port of the Earl Grey VS Code theme (https://earl-grey.halt.wtf, by June Kelly), matched
    token by token against what VS Code + Red Hat's Java extension actually paint.

    Every Java attributes key is set explicitly: anything left undefined here would fall back to
    the bundled "Default" scheme (purple bold fields, italic statics, underlined reassigned
    variables, olive annotations ...), which is what made earlier ports look different.
  -->
  <metaInfo>
    <property name="created">2026-10-16T00:00:00</property>
    <property name="ide">idea</property>
    <property name="ideVersion">2025.2.0.0</property>
  </metaInfo>
